{
  "name": "robot-web-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Web control interface for ESP32 legged robots, embedded into the firmware",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/embed.mjs",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "ws": "^8.22.1"
  }
}
